      "text_color": "#F3EBDD"
     }
    },
    "body": {
     "type": "text",
     "blocks": {},
     "settings": {
      "text": "<p>A round instrument for attention. A book you can type into when the network is gone. A listening phone that keeps the voice at home. The Orphanage bench builds what parents can hand to a child and what researchers can hold when the internet cannot be trusted.</p>",
      "width": "fit-content",
      "max_width": "narrow",
      "alignment": "center",
      "type_preset": "paragraph",
      "font": "var(--font-body--family)",
      "font_size": "",
      "line_height": "normal",
      "letter_spacing": "normal",
      "case": "none",
      "wrap": "balance",
      "text_color": "#D6CCBC",
      "background": false,
      "background_color": "#00000026",
      "corner_radius": 0,
      "padding-block-start": 0,
      "padding-block-end": 0,
      "padding-inline-start": 0,
      "padding-inline-end": 0
     }
    },
    "cta": {
     "type": "button",
     "blocks": {},
     "settings": {
      "label": "Browse the work",
      "link": "shopify://collections/all",
      "open_in_new_tab": false,
