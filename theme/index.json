    "border_color": "#B89A5D",
    "border_radius": 0,
    "padding-block-start": 64,
    "padding-block-end": 72
   },
   "blocks": {
    "kicker": {
     "type": "text",
     "blocks": {},
     "settings": {
      "text": "<p>THE ATELIER \u00b7 CASTALIA INSTITUTE</p>",
      "width": "fit-content",
      "max_width": "normal",
      "alignment": "center",
      "type_preset": "paragraph",
      "font": "var(--font-subheading--family)",
      "font_size": "0.75rem",
      "line_height": "normal",
      "letter_spacing": "loose",
      "case": "uppercase",
      "wrap": "pretty",
      "text_color": "#B89A5D",
      "background": false,
      "background_color": "#00000026",
      "corner_radius": 0,
      "padding-block-start": 0,
      "padding-block-end": 0,
      "padding-inline-start": 0,
      "padding-inline-end": 0
     }
    },
    "lead": {
     "type": "jumbo-text",
     "blocks": {},
     "settings": {
      "text": "Firm hands, steady mind \u2014 instruments for inquiry.",
      "font": "heading",
      "alignment": "center",
      "line_height": "1",
      "letter_spacing": "-0.03em",
      "case": "none",
      "text_effect": "none",
      "animation_repeat": false,
      "text_color": "#F3EBDD"
     }
    },
    "body": {
     "type": "text",
     "blocks": {},
     "settings": {
      "text": "<p>A round instrument for attention. A book you can type into when the network is gone. A listening phone that keeps the voice at home. The Atelier bench builds what parents can hand to a child and what researchers can hold when the internet cannot be trusted.</p>",
      "width": "fit-content",
      "max_width": "narrow",
      "alignment": "center",
      "type_preset": "paragraph",
      "font": "var(--font-body--family)",
      "font_size": "",
      "line_height": "normal",
      "letter_spacing": "normal",
      "case": "none",
      "wrap": "balance",
      "text_color": "#D6CCBC",
      "background": false,
      "background_color": "#00000026",
      "corner_radius": 0,
      "padding-block-start": 0,
      "padding-block-end": 0,
      "padding-inline-start": 0,
      "padding-inline-end": 0
     }
    },
    "cta": {
     "type": "button",
     "blocks": {},
     "settings": {
      "label": "Browse the work",
      "link": "shopify://collections/all",
      "open_in_new_tab": false,
      "style_class": "button-custom",
      "custom_button_background": "rgba(11,16,32,0)",
      "custom_button_text": "#F3EBDD",
      "custom_button_border": "#B89A5D",
      "width": "fit-content",
      "custom_width": 100,
      "alignment": "center"
     }
    },
    "note": {
     "type": "text",
     "blocks": {},
     "settings": {
      "text": "<p>Beta hardware is in the hands of a small circle now. Everything else is developing in public.</p>",
      "width": "fit-content",
      "max_width": "normal",
      "alignment": "center",
      "type_preset": "paragraph",
      "font": "var(--font-subheading--family)",
      "font_size": "0.875rem",
      "line_height": "loose",
      "letter_spacing": "normal",
      "case": "none",
      "wrap": "pretty",
      "text_color": "#B89A5DCC",
      "background": false,
      "background_color": "#00000026",
      "corner_radius": 0,
      "padding-block-start": 0,
      "padding-block-end": 0,
      "padding-inline-start": 0,
      "padding-inline-end": 0
     }
    }
   },
   "block_order": [
    "kicker",
    "lead",
    "body",
    "cta",
    "note"
   ]
  },
